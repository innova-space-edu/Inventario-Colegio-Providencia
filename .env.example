NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# SOLO SERVIDOR. Nunca usar NEXT_PUBLIC_ para esta clave.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY

# Correo saliente vía Resend. Mantener estas variables SOLO en servidor/Vercel.
RESEND_API_KEY=re_YOUR_RESEND_KEY
RESEND_EMAIL_FROM=Inventario TI Colegio Providencia <correo@YOUR_VERIFIED_DOMAIN.cl>

# El correo real de cada usuario autenticado se usa como Reply-To automáticamente.
# El superadministrador no envía correos; solo consulta el historial de evidencias.
